#include <iostream>
#include <string>

using namespace std;

int main()
{
    // Korištenje dvodimenzionalnog niza (matrice) stringova
    // Redci su marke automobila, stupci su modeli
    string automobili[5][6] = {
        {"BMW", "M3", "M4", "X3", "X4", "i4"},
        {"Ferrari", "296 GTB", "Roma", "F8 Tributo", "Purosangue", "SF90 Stradale"},
        {"Porsche", "911", "Cayenne", "Panamera", "Taycan", "718 Cayman"},
        {"Mercedes", "C-klasa", "G-klasa", "Benz EQS", "AMG GT", "Benz GLE"},
        {"McLaren", "P1", "720S", "Artura", "GT", "Senna"}
    };

    for(int i = 0; i < 5; i++) {
        // Ispis rednog broja i marke
        cout << i + 1 << ". " << automobili[i][0] << endl;
        
      for(int j = 1; j < 6; j++) {
          if(automobili[i][j] != "") {
              cout << "   " << automobili[i][j] << endl;
          }
       }
    }

    return 0;
}
